{
  "expo": {
    "name": "DMM Library",
    "slug": "dmm-library",
    "version": "0.1.0",
    "orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"scheme": "dmm-library",
		"icon": "./assets/icon.png",
		"ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.debridmediamanager.library"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.debridmediamanager.library"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
